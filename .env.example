# =============================================================================
# .env.example — Variáveis de ambiente da pilha (§11 do contrato)
# Como usar:
#   cp .env.example .env
#   Preencha os placeholders __...__ antes de subir o Docker.
# Nunca suba o .env real em controle de versão (adicione ao .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados PostgreSQL (serviço `db` no docker-compose.yml)
# O n8n usa estas mesmas credenciais na credencial "Postgres Barbearia".
# -----------------------------------------------------------------------------
POSTGRES_USER=barb_user
POSTGRES_PASSWORD=__TROCAR_SENHA_BANCO__
POSTGRES_DB=barbearia
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# n8n (serviço `n8n`)
# N8N_PORT: porta local onde a interface do n8n fica disponível.
# N8N_ENCRYPTION_KEY: chave aleatória que criptografa as credenciais salvas no
# banco do n8n. Gere uma chave forte, por exemplo com: openssl rand -hex 32
# -----------------------------------------------------------------------------
N8N_PORT=5678
N8N_ENCRYPTION_KEY=__TROCAR_CHAVE_ALEATORIA__

# -----------------------------------------------------------------------------
# Credenciais de IA e Google Calendar
# GEMINI_API_KEY: chave do Google AI Studio; também deve ser colada na
# credencial "Google Gemini API" dentro do n8n.
# GOOGLE_CALENDAR_ID: agenda que receberá os eventos; também é substituído no
# workflow de sincronização (placeholder __GOOGLE_CALENDAR_ID__).
# -----------------------------------------------------------------------------
GEMINI_API_KEY=__COLE_SUA_CHAVE__
GOOGLE_CALENDAR_ID=__SEU_CALENDARIO__@group.calendar.google.com

# -----------------------------------------------------------------------------
# Dados do negócio (FAQ e mensagens do agente; nunca inventar endereço no prompt)
# BUSINESS_HOURS_TEXT: texto exibido quando o cliente pergunta o horário.
# PIX_CHAVE: chave usada nas mensagens de pagamento.
# -----------------------------------------------------------------------------
BUSINESS_NAME=Barbearia Exemplo
BUSINESS_ADDRESS=__ENDERECO_EXEMPLO__
BUSINESS_HOURS_TEXT=Terça a Sábado, 09h às 19h (intervalo para almoço 12h–13h)
PIX_CHAVE=__CHAVE_PIX_EXEMPLO__

# -----------------------------------------------------------------------------
# Regras de agendamento
# CANCEL_MIN_HOURS: antecedência mínima (horas) para cancelar/reagendar.
# SLOT_INTERVAL_MINUTES: granularidade dos horários oferecidos em minutos.
# -----------------------------------------------------------------------------
CANCEL_MIN_HOURS=2
SLOT_INTERVAL_MINUTES=30

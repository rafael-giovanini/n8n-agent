# ============================================================================
# Ponte WhatsApp (Baileys) -> n8n — variáveis de exemplo (contrato §9)
# Copie este arquivo para `.env` na mesma pasta `bridge/` e preencha os valores.
# Nenhum segredo real fica neste arquivo: use placeholders durante o desenvolvimento.
# ============================================================================

# URL do webhook do workflow principal do n8n (payload neutro §2.1)
# Exemplo local do contrato: http://localhost:5678/webhook/whatsapp/incoming
N8N_WEBHOOK_URL=http://localhost:5678/webhook/whatsapp/incoming

# Porta da API local da ponte (endpoints POST /send da §2.3 e GET /health)
PORT=3000

# Pasta onde o Baileys salva as credenciais da sessão (useMultiFileAuthState)
SESSION_DIR=./session

# Número da linha da barbearia no formato internacional, só dígitos: DDI + DDD + número
# Usado apenas quando REQUEST_PAIRING_CODE=true e ainda não há sessão salva
OWNER_NUMBER=5511999990000

# true  = usa código de pareamento (requestPairingCode) enviado ao OWNER_NUMBER
# false = exibe o QR Code no terminal para escanear com o WhatsApp (Aparelhos conectados)
REQUEST_PAIRING_CODE=true

# Timeout em milissegundos do POST ao n8n antes de enviar a mensagem de fallback
# Padrão do contrato: 25000 (25 segundos)
MESSAGE_TIMEOUT_MS=25000

# Mensagem amigável enviada ao cliente quando o n8n não responde dentro do timeout
# (instabilidade de rede ou do fluxo; a ponte nunca derruba o processo)
FALLBACK_MESSAGE=Desculpe! Estou com dificuldade para processar sua mensagem agora. Pode tentar novamente em alguns instantes?
